[user]
    email = chriswachter999@gmail.com
    name = Chris Wachter

[diff]
    tool = difftastic
[difftool]
    prompt = false
[difftool "difftastic"]
    cmd = difft $LOCAL $REMOTE

[merge]
    tool = kdiff3
[mergetool]
    prompt = false
    keepBackup = false
[mergetool "kdiff3"]
    cmd = kdiff3 $BASE $LOCAL $REMOTE -o $MERGED

[color]
    ui = true

[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green

[color "diff"]
    meta = yellow bold
    frag = magenta bold
    old = red bold
    new = green bold

[color "status"]
    added = yellow
    changed = green
    untracked = red

[alias]
    g = !git log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
    churn = !git log --all -M -C --name-only --format='format:' "$@" | sort | grep -v '^$' | uniq -c | sort | awk 'BEGIN {print "count,file"} {print $1 "," $2}'

[core]
    excludesfile = /home/shumberg/.gitignore
[push]
    default = matching
